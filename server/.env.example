# Supabase
# 실제 값은 server/.env 에 채워주세요 (.env 는 gitignore 됨)
SUPABASE_URL=https://your-project-ref.supabase.co
# 신규 publishable 키 (sb_publishable_...) — anon 키는 레거시(2026년 말 비활성화 예정)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 데이터 소스 선택: supabase | memory (미지정 시 SUPABASE_URL 있으면 supabase, 없으면 memory)
DATA_SOURCE=supabase

# 서버
PORT=3000
ALLOWED_ORIGINS=
